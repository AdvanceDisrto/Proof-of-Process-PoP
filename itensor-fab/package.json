{
  "name": "@innovulis/itensor-fab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tailwind:cli": "@tailwindcss/cli -i ./src/index.css -o ./dist/tailwind-cli.css --minify",
    "tailwind:postcss": "postcss ./src/index.css -o ./dist/tailwind-postcss.css"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "postcss": "^8.5.0",
    "typescript": "^5.8.0",
    "vite": "^8.1.0",
    "postcss-cli": "^11.0.0"
  }
}
