{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iproof-v1.schema.json",
  "title": "iProof Evidence Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "evidence_id",
    "intent",
    "routing",
    "execution",
    "resources",
    "result",
    "reproduction"
  ],
  "properties": {
    "protocol": {
      "const": "IPROOF-v1"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_sha256",
        "intent_class"
      ],
      "properties": {
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "intent_class": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "router_version",
        "action_id",
        "execution_class",
        "reason",
        "module_ids"
      ],
      "properties": {
        "router_version": {
          "type": "string",
          "minLength": 1
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "execution_class": {
          "enum": [
            "INTELLIGENCE",
            "DETERMINISTIC",
            "HUMAN_REVIEW",
            "BLOCKED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "module_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_sha256",
        "runtime_version",
        "output_sha256",
        "completed_at"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compute",
        "network",
        "storage"
      ],
      "properties": {
        "compute": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "device",
            "driver",
            "memory_bytes"
          ],
          "properties": {
            "device": {
              "type": "string"
            },
            "driver": {
              "type": "string"
            },
            "memory_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string"
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_bytes"
          ],
          "properties": {
            "artifact_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "ACTION_REQUIRED",
            "QUARANTINED"
          ]
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "command",
        "environment_hash",
        "expected_output_sha256"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "environment_hash": {
          "$ref": "#/$defs/sha256"
        },
        "expected_output_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
