{
  "spec": "innovulis-platform-architecture-matrix/1.0",
  "architectures": {
    "x86_64": {
      "isa_family": "x86",
      "abi": "LP64",
      "native_build": true,
      "optional_features": ["SSE2", "AVX2", "AVX-512", "AMX"],
      "physical_execution_claim": "ACTION_REQUIRED"
    },
    "aarch64": {
      "isa_family": "ARM",
      "abi": "LP64",
      "native_build": true,
      "optional_features": ["NEON", "SVE", "SVE2", "SME"],
      "physical_execution_claim": "ACTION_REQUIRED"
    }
  },
  "portable_contract": {
    "required": ["C11", "Python 3.12", "SHA-256", "deterministic JSON encoding"],
    "forbidden_assumption": "A compiler target or ISA feature flag does not prove physical execution on that feature.",
    "truth_rule": "Architecture compatibility is a software property; physical hardware execution requires independent runtime evidence."
  },
  "anchor_packages": {
    "solana_anchor_cli": {
      "role": "optional ARM64-compatible smart-contract development tool",
      "status": "external_dependency_not_required_by_pop"
    },
    "greymass_anchor_wallet": {
      "role": "optional ARM64-compatible blockchain wallet",
      "status": "external_dependency_not_required_by_pop"
    },
    "unbound_anchor": {
      "role": "optional ARM64-compatible DNSSEC trust-anchor utility",
      "status": "external_dependency_not_required_by_pop"
    }
  }
}
