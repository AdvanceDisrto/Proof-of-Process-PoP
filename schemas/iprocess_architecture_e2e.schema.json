{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "iProcessArchitectureE2EBlueprint",
  "description": "End-to-end structural specification for i Process Architecture classes 1000 through 5000+. This schema describes the matrix; it does not assert physical execution.",
  "type": "object",
  "properties": {
    "system_metadata": {
      "type": "object",
      "properties": {
        "architecture_version": {"type": "string", "enum": ["i-v4.2.1-Sovereign"]},
        "total_active_tasks": {"type": "integer", "minimum": 5000},
        "consensus_mechanism": {"type": "string", "enum": ["Parallel Proof of Vote (PPoV)"]},
        "base_currency_ecosystem": {"type": "string", "enum": ["$SOV"]}
      },
      "required": ["architecture_version", "total_active_tasks", "consensus_mechanism", "base_currency_ecosystem"],
      "additionalProperties": false
    },
    "execution_pipeline": {
      "type": "array",
      "items": {"$ref": "#/$defs/process_class"},
      "minItems": 5,
      "maxItems": 5
    }
  },
  "required": ["system_metadata", "execution_pipeline"],
  "additionalProperties": false,
  "$defs": {
    "process_class": {
      "type": "object",
      "properties": {
        "class_id": {
          "type": "integer",
          "enum": [1000, 2000, 3000, 4000, 5000]
        },
        "class_name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "sub_matrices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "task_range": {"type": "string", "minLength": 1},
              "functional_focus": {"type": "string", "minLength": 1},
              "verification_method": {"type": "string", "minLength": 1},
              "explicit_tasks_monitored": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            },
            "required": ["task_range", "functional_focus", "verification_method", "explicit_tasks_monitored"],
            "additionalProperties": false
          }
        }
      },
      "required": ["class_id", "class_name", "description", "sub_matrices"],
      "additionalProperties": false
    }
  }
}